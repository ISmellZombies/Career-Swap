table Jobs
	lineageTag: 2903a5ba-5153-4579-9ec1-6e7baf102b16

	measure Opportunities = COUNTROWS ( Jobs )
		formatString: #,0
		lineageTag: 15c1d0c5-fb0f-4b99-b273-22b480ea64cf

	measure 'Eligible Opportunities' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Eligible] = TRUE () ) )
		formatString: #,0
		lineageTag: 32b52f00-1ab0-47dd-8af8-9f67227715b3

	measure 'Eligibility Rate' = DIVIDE ( [Eligible Opportunities], [Opportunities] )
		formatString: 0.0%
		lineageTag: 15a506a0-3fb7-4a68-8e83-62fd65ed6b32

	measure Applications = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Applied] = 1 ) )
		formatString: #,0
		lineageTag: 983f8b78-bdbe-4bca-9e4d-2c88f946a6d0

	measure 'Application Rate' = DIVIDE ( [Applications], [Opportunities] )
		formatString: 0.0%
		lineageTag: 6e96c38e-55e6-4dc5-8c37-8471b7dd25c9

	measure 'Mean Fit' = AVERAGE ( Jobs[FitScore] )
		formatString: 0.0%
		lineageTag: d5d64b24-a9f3-4a08-a25e-2d57a57025d7

	measure 'Median Fit' = MEDIAN ( Jobs[FitScore] )
		formatString: 0.0%
		lineageTag: 637fbf8b-eb26-414f-b24a-42143798f712

	measure 'At Target 80' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[FitScore] >= 0.80 ) )
		formatString: #,0
		lineageTag: 94063e02-2e78-4c14-8f31-0da5a5ddbcae

	measure 'Tolerance 75 to 79' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[FitScore] >= 0.75 ), KEEPFILTERS ( Jobs[FitScore] < 0.80 ) )
		formatString: #,0
		lineageTag: 50fe6673-593f-4a85-b2a2-c12ffb94d891

	measure 'Eligible Applications' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Eligible] = TRUE () ), KEEPFILTERS ( Jobs[Applied] = 1 ) )
		formatString: #,0
		lineageTag: 4fb6548f-46e1-4c64-a029-7a5d04ae169d

	measure 'Eligible Not Applied' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Eligible] = TRUE () ), KEEPFILTERS ( Jobs[Applied] = 0 ) )
		formatString: #,0
		lineageTag: 554cf2be-e9dd-4fb7-a2f1-8a23966dd3f2

	measure 'Below Threshold Applications' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Eligible] = FALSE () ), KEEPFILTERS ( Jobs[Applied] = 1 ) )
		formatString: #,0
		lineageTag: 2db3135c-3e8c-4932-a404-41c74240da9c

	measure 'Below Threshold Not Applied' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[Eligible] = FALSE () ), KEEPFILTERS ( Jobs[Applied] = 0 ) )
		formatString: #,0
		lineageTag: 3dfce5ac-41ca-44df-b6d3-2616c40cbfe2

	measure 'Eligible Application Rate' = DIVIDE ( [Eligible Applications], [Eligible Opportunities] )
		formatString: 0.0%
		lineageTag: 7605b0aa-faf9-4cb5-ac37-bdd8d87941ca

	measure 'Below Threshold Application Rate' = DIVIDE ( [Below Threshold Applications], [Opportunities] - [Eligible Opportunities] )
		formatString: 0.0%
		lineageTag: 722e0e22-9c14-4c1a-919d-9c6d4c268f81

	measure 'Salary Displayable Count' = CALCULATE ( [Opportunities], KEEPFILTERS ( Jobs[SalaryStatus] = "Displayable as recorded" ) )
		formatString: #,0
		lineageTag: d846410e-8c7e-4f30-b1f0-52e26d716ed7

	measure 'Salary Coverage' = DIVIDE ( [Salary Displayable Count], [Opportunities] )
		formatString: 0.0%
		lineageTag: 3b5a45e1-75cc-43a1-a8a6-c1e44feef673

	measure 'Median Recorded Mid Salary' = CALCULATE ( MEDIAN ( Jobs[SalaryMidRaw] ), KEEPFILTERS ( Jobs[SalaryStatus] = "Displayable as recorded" ) )
		formatString: $#,0
		lineageTag: c92fbda8-1a58-46c0-9537-aa2f9acf998c

