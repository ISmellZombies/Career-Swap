	partition Jobs = m
		mode: import
		source =
				let
					Source1 = Excel.Workbook(File.Contents(SourceRoot & "\Get a Job - Study 1-100.xlsx"), null, true),
					Study1Sheet = Source1{[Item="Draft 1",Kind="Sheet"]}[Data],
					Study1Rows = Table.FirstN(Table.Skip(Study1Sheet, 14), 103),
					Study1Indexed = Table.AddIndexColumn(Study1Rows, "SourceRow", 15, 1, Int64.Type),
					Source2 = Excel.Workbook(File.Contents(SourceRoot & "\Get a Job - study 2 100-200.xlsx"), null, true),
					Study2Sheet = Source2{[Item="Draft 1",Kind="Sheet"]}[Data],
					Study2Rows = Table.FirstN(Table.Skip(Study2Sheet, 14), 59),
					Study2Indexed = Table.AddIndexColumn(Study2Rows, "SourceRow", 15, 1, Int64.Type),
					RawText = (v as any) as nullable text => if v = null then null else Text.From(v, "en-US"),
					Norm = (v as any) as nullable text => let s = if v = null then null else Text.Trim(Text.From(v, "en-US")), l = if s = null then "" else Text.Lower(s) in if List.Contains({"", "not_listed", "not listed", "n/a", "-"}, l) then null else s,
					RawNumber = (v as any) as nullable number => try Number.From(v, "en-US") otherwise null,
					ImportRows = (t as table, study as text, midCol as text, seniorCol as text, locationCol as text, titleCol as text, employmentCol as text, dutiesCol as text, familyCol as text, dateCol as text, sourceCol as text, notesCol as text, extraNotesCol as nullable text) as table =>
						let
							Records = Table.ToRecords(t),
							Mapped = Table.FromRecords(List.Transform(Records, (r) =>
								let
									Value = (c as text) as any => Record.FieldOrDefault(r, c, null),
									JobNo = Int64.From(RawNumber(Value("Column2"))),
									EmployerRaw = RawText(Value("Column3")),
									Received = try Int64.From(RawNumber(Value("Column7"))) otherwise null,
									Success = try Int64.From(RawNumber(Value("Column8"))) otherwise null,
									WorkRaw = RawText(Value("Column10")),
									SearchRaw = RawText(Value("Column11")),
									Fit = RawNumber(Value("Column13")),
									Applied = Int64.From(RawNumber(Value("Column17"))),
									SalaryText = RawText(Value("Column20")),
									Entry = RawNumber(Value("Column22")),
									Mid = RawNumber(Value(midCol)),
									Senior = RawNumber(Value(seniorCol)),
									LocationRaw = RawText(Value(locationCol)),
									TitleRaw = RawText(Value(titleCol)),
									EmploymentRaw = RawText(Value(employmentCol)),
									DutiesRaw = RawText(Value(dutiesCol)),
									FamilyRaw = RawText(Value(familyCol)),
									DateValue = Value(dateCol),
									DateRaw = RawText(DateValue),
									SourceRaw = RawText(Value(sourceCol)),
									NotesRaw = RawText(Value(notesCol)),
									ExtraRaw = if extraNotesCol = null then null else RawText(Value(extraNotesCol)),
									Employer = Norm(EmployerRaw),
									WorkN = Norm(WorkRaw),
									Work = if WorkN = null then "Not specified" else if Text.Lower(WorkN) = "remote" then "Remote" else if List.Contains({"hybrid", "hyrbid"}, Text.Lower(WorkN)) then "Hybrid" else if List.Contains({"on-site", "on site", "onsite"}, Text.Lower(WorkN)) then "On-site" else "Not specified",
									EmploymentN = Norm(EmploymentRaw),
									Employment = if EmploymentN = null then "Not specified" else if List.Contains({"full time", "full_time", "full-time"}, Text.Lower(EmploymentN)) then "Full-time" else if List.Contains({"contract", "cointract"}, Text.Lower(EmploymentN)) then "Contract" else "Not specified",
									Title = Norm(TitleRaw),
									FamilyN = Norm(FamilyRaw),
									Family = if FamilyN = null and study = "Study2" then "Not classified" else if FamilyN = null then "Not specified" else FamilyN,
									Eligible = Fit >= 0.75,
									FitBand = if Fit >= 0.80 then "Target: 80–100%" else if Fit >= 0.75 then "Tolerance: 75–<80%" else "Below minimum: <75%",
									Quadrant = if Eligible and Applied = 1 then "Qualified / Applied" else if Eligible then "Qualified / Not applied" else if Applied = 1 then "Below / Applied" else "Below / Not applied",
									Annuality = if SalaryText = null then false else List.AnyTrue(List.Transform({"monthly", "month", "hour", "/hr", "/hour", "week", "/week", "day", "/day"}, each Text.Contains(Text.Lower(SalaryText), _))),
									SalaryStatus = if Entry = null or Mid = null or Senior = null then "Incomplete" else if Annuality then "Nonannual explicit" else if not (Entry <= Mid and Mid <= Senior) then "Invalid range" else if Text.Contains(Text.Lower(Text.Combine(List.RemoveNulls({NotesRaw, ExtraRaw}), " ")), "peso") then "Non-USD noted" else "Displayable as recorded",
									PostingDate = if Value.Is(DateValue, type number) then Date.AddDays(#date(1899, 12, 30), Number.RoundDown(DateValue)) else if Value.Is(DateValue, type date) then DateValue else null,
									Artifact = FamilyN <> null and Text.Lower(FamilyN) = "n/a (artifact)",
									EmployerLabel = if Employer = null then "(Employer not listed)" else Employer,
									RowLabel = (if Employer = null then "(Employer not listed)" else Employer) & " · " & (if Title = null then "(Title not listed)" else Title)
								in
									[StudyID=study, SourceRow=Int64.From(Value("SourceRow")), JobNo=JobNo, JobID=study & "-" & Text.PadStart(Text.From(JobNo),3,"0"), EmployerRaw=EmployerRaw, EmployerLabel=EmployerLabel, ReceivedRaw=Received, SuccessRaw=Success, WorkArrangementRaw=WorkRaw, WorkArrangement=Work, SearchTermRaw=SearchRaw, FitScore=Fit, Applied=Applied, SalaryTextRaw=SalaryText, SalaryEntryRaw=Entry, SalaryMidRaw=Mid, SalarySeniorRaw=Senior, LocationRaw=LocationRaw, JobTitleRaw=TitleRaw, JobTitle=Title, EmploymentTypeRaw=EmploymentRaw, EmploymentType=Employment, DutiesRaw=DutiesRaw, JobFamilyRaw=FamilyRaw, JobFamily=Family, PostingDateRaw=DateRaw, PostingDate=PostingDate, JobSourceRaw=SourceRaw, JobSource=if Norm(SourceRaw)=null then "Not specified" else Norm(SourceRaw), NotesRaw=NotesRaw, ExtraNotesRaw=ExtraRaw, IsArtifact=Artifact, FitBand=FitBand, Eligible=Eligible, DecisionQuadrant=Quadrant, SalaryStatus=SalaryStatus, RowLabel=RowLabel]
							)),
							Typed = Table.TransformColumnTypes(Mapped, {{"StudyID", type text},{"SourceRow", Int64.Type},{"JobNo", Int64.Type},{"JobID", type text},{"EmployerRaw", type text},{"EmployerLabel", type text},{"ReceivedRaw", Int64.Type},{"SuccessRaw", Int64.Type},{"WorkArrangementRaw", type text},{"WorkArrangement", type text},{"SearchTermRaw", type text},{"FitScore", type number},{"Applied", Int64.Type},{"SalaryTextRaw", type text},{"SalaryEntryRaw", type number},{"SalaryMidRaw", type number},{"SalarySeniorRaw", type number},{"LocationRaw", type text},{"JobTitleRaw", type text},{"JobTitle", type text},{"EmploymentTypeRaw", type text},{"EmploymentType", type text},{"DutiesRaw", type text},{"JobFamilyRaw", type text},{"JobFamily", type text},{"PostingDateRaw", type text},{"PostingDate", type date},{"JobSourceRaw", type text},{"JobSource", type text},{"NotesRaw", type text},{"ExtraNotesRaw", type text},{"IsArtifact", type logical},{"FitBand", type text},{"Eligible", type logical},{"DecisionQuadrant", type text},{"SalaryStatus", type text},{"RowLabel", type text}}, "en-US")
						in
							Typed,
					Study1Source = ImportRows(Study1Indexed, "Study1", "Column28", "Column34", "Column41", "Column44", "Column45", "Column47", "Column48", "Column49", "Column50", "Column52", null),
					Study2Source = ImportRows(Study2Indexed, "Study2", "Column29", "Column35", "Column42", "Column45", "Column46", "Column48", "Column49", "Column50", "Column51", "Column53", "Column55"),
					Jobs = Table.Combine({Study1Source, Study2Source}),
					Sorted = Table.Sort(Jobs, {{"StudyID", Order.Ascending},{"JobNo", Order.Ascending}})
				in
					Sorted

